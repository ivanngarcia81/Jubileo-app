# Copia este archivo a .env y llena los valores.
# .env está en .gitignore. Las llaves nunca van en un commit.

# ---------- Base de datos y autenticación (Supabase o equivalente) ----------
VITE_SUPABASE_URL=
# La llave pública. Supabase la llama `anon` en proyectos viejos y
# `publishable` en los nuevos: es la misma y basta con poner una.
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=
#
# Ojo al copiar del panel Connect de Supabase: entrega un bloque de dos
# renglones. Cada variable va en su propio renglón, y en el campo de valor va
# SOLO el valor — sin el `VITE_...=` adelante.

# Solo servidor. Nunca con prefijo VITE_: eso la publicaría en el bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe ----------
# Los webhooks son la única fuente de verdad del nivel del usuario.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECIO_MENSUAL=
STRIPE_PRECIO_ANUAL=

# ---------- Avisos (cron por hora) ----------
# La misma cuenta de Resend que manda los códigos de entrada: la llave `re_…`
# y el mismo remitente que está puesto en el SMTP de Supabase. Una cuenta, dos
# usos. Ver "El correo de entrada" en el README.
CORREO_API_KEY=
CORREO_REMITENTE=hola@jubileofinanciero.com
# Solo servidor: la URL sin prefijo, para que `api/avisos.ts` no dependa de una
# variable pensada para el navegador.
SUPABASE_URL=
# Lo inventas tú: cualquier cadena larga y al azar. Va en dos lados con el
# MISMO valor — en Vercel, para que /api/avisos lo compare, y en GitHub
# (Settings → Secrets → Actions), para que el reloj lo mande. Sin él,
# cualquiera con la dirección de /api/avisos dispara los correos de todos.
CRON_SECRET=
URL_APP=

# ---------- App ----------
VITE_URL_APP=http://localhost:5173
